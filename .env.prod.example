# RBAC Lens — prod stack. Copied to .env.prod by
# `make up prod`. POSTGRES_PASSWORD is generated when empty, and `make up prod`
# sets it on the database each time, so changing it here is enough.

# Azure service principal, read-only (docs/deployment.md#azure-identity-least-privilege).
# Fill them in here, or leave them empty and save them on the Settings page
# instead. `make restart <env>` applies a change; `make whoami <env>` checks it.
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=

# Fernet key encrypting the credentials saved on the Settings page.
# Generated by `make up` / `make env` when empty (`make genkey` prints one).
# Keep it: changing it makes saved credentials unreadable.
ENCRYPTION_KEY=

# Postgres. The password is generated by `make up` / `make env` when empty.
POSTGRES_USER=rbaclens
POSTGRES_PASSWORD=
POSTGRES_DB=rbaclens_prod

# Origins allowed to call the API (JSON array) — the URL users open.
CORS_ORIGINS=["http://localhost"]

# Optional CA bundle for outbound TLS (corporate proxies that intercept HTTPS).
# REQUESTS_CA_BUNDLE is the path INSIDE the backend container; bind-mount the
# host file in the compose overlay. See docs/deployment.md.
REQUESTS_CA_BUNDLE=

# Time zone of the backend container: the daily check of the whole tenant runs
# at 06:00 in it. Unset = UTC. Example: TZ=Europe/Zurich
# TZ=

# Who can reach the app. Default: this machine only (127.0.0.1). To open it to
# the network, set 0.0.0.0 (every interface) or one of the machine's addresses,
# and turn sign-in on first (Settings > Authentication): with sign-in off,
# anyone who reaches the app can read and change everything.
# BIND_ADDRESS=0.0.0.0

# Host names the site answers to, besides localhost, *.local names and IP
# addresses (space-separated). Requests for any other name are dropped.
# EXTRA_SERVER_NAMES=rbaclens.lab.example

# Automatic backups (the `backup` service): one pg_dump a day into backups/,
# from this hour on (container time, TZ), keeping the newest BACKUP_KEEP.
# BACKUP_HOUR=2
# BACKUP_KEEP=14

# Email notifications (docs/deployment.md#email-notifications). By default the
# stack sends to its Mailpit container (smtp, nothing reaches anyone; inbox on
# :8025 prod / :8026 test). For real email through Microsoft Graph (needs the
# Mail.Send application permission):
# NOTIFICATION_CHANNEL=email
# NOTIFICATION_SENDER=rbaclens@yourdomain
# NOTIFICATION_ADMIN_EMAIL=azure-admins@yourdomain
# PUBLIC_URL=http://localhost

# AI wording (Settings > Advice): new texts per day at most; 0 = no limit.
# AI_DAILY_LIMIT=200
