# RBAC Lens — test stack (workstation). Copied to .env.test by `make up test`.
# The test overlay sets STAGE, LOG_LEVEL and CORS for you. The
# database user and name are the built-in rbaclens / rbaclens_test; its
# password is generated into POSTGRES_PASSWORD below, and `make up test` sets
# it on the database, so an existing volume follows a change too. All test
# ports listen on 127.0.0.1 only.

# Azure service principal, read-only (docs/deployment.md#azure-identity-least-privilege).
# Fill them in here, or leave them empty and save them on the Settings page
# instead. `make restart <env>` applies a change; `make whoami <env>` checks it.
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=

# Fernet key encrypting the credentials saved on the Settings page.
# Generated by `make up` / `make env` when empty (`make genkey` prints one).
# Keep it: changing it makes saved credentials unreadable.
ENCRYPTION_KEY=

# Database password. Generated by `make up` / `make env` when empty.
POSTGRES_PASSWORD=

# Optional CA bundle for outbound TLS (corporate proxies that intercept HTTPS).
# REQUESTS_CA_BUNDLE is the path INSIDE the backend container; bind-mount the
# host file in the compose overlay. See docs/deployment.md.
REQUESTS_CA_BUNDLE=

# Time zone of the backend container: the daily check of the whole tenant runs
# at 06:00 in it. Unset = UTC. Example: TZ=Europe/Zurich
# TZ=

# Email notifications (docs/deployment.md#email-notifications). By default the
# stack sends to its Mailpit container (smtp, nothing reaches anyone; inbox on
# :8025 prod / :8026 test). For real email through Microsoft Graph (needs the
# Mail.Send application permission):
# NOTIFICATION_CHANNEL=email
# NOTIFICATION_SENDER=rbaclens@yourdomain
# NOTIFICATION_ADMIN_EMAIL=azure-admins@yourdomain
# PUBLIC_URL=http://localhost
